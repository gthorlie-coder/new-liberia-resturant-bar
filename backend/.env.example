PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://username:password@localhost:5432/new_liberia_restaurant

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of frontend URLs allowed to call this API (no wildcard in production)
ALLOWED_ORIGINS=https://new-liberia.netlify.app

# Optional shared secret for payment provider webhooks — set this and
# configure the same value with MTN/Orange if their dashboard supports it
WEBHOOK_SHARED_SECRET=

# Payment providers — fill in once your merchant accounts are approved

# MTN Mobile Money (Collections API — momodeveloper.mtn.com)
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=LRD

# Orange Money (developer.orange.com)
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CURRENCY=LRD
ORANGE_MONEY_RETURN_URL=
ORANGE_MONEY_CANCEL_URL=
ORANGE_MONEY_WEBHOOK_URL=

# Card processor (Stripe/Flutterwave) — wire in when ready
STRIPE_SECRET_KEY=
