PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://liberia_user:liberia_pass@localhost:5432/new_liberia

# Firebase Admin (auth token verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Payment providers (sandbox keys — never commit real keys)
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
LONESTAR_MOMO_API_KEY=
LONESTAR_MOMO_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
